# DGSM OAuth (PKCE) — .env 로 복사해서 쓴다. .env 는 커밋하지 않는다.
# 실행: flutter run --dart-define-from-file=.env
#
# 여기 값은 secret 이 아니다. client_id 는 PKCE 공개 클라이언트 식별자고,
# API 주소는 어차피 모든 요청의 목적지라 숨겨도 의미가 없다.
# 실제 방어선은 게이트웨이 JWT 검증이다.

# 필수. 개발/운영 서버가 갈리는 값이라 코드에 기본값을 두지 않는다.
# 아래는 개발 서버 주소다. 운영 빌드는 반드시 운영 주소로 덮어쓴다.
COWORK_API_BASE_URL=https://ssh.gsmsv.site:22132/api

# 아래 둘은 dgsm_oauth_config.dart 의 기본값과 같다. 바꿀 일 없으면 생략해도 된다.
DGSM_CLIENT_ID=e7cbba21-deb8-41a2-8648-f9a2234b343f
DGSM_REDIRECT_URI=cowork://oauth/callback
